{
  "name": "@openagt/tickets",
  "version": "0.1.14",
  "description": "Tickets for coding agents: markdown tickets with their plans and claims, kept on a branch of the project's repository and changed with the tickets command, and the commands about them: plan, plan-tickets, triage, update-tickets and suggest-tickets-to-work-on.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openagt/openagent.git",
    "directory": "packages/tickets"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "bin/tickets",
    "SKILL.md",
    "commands"
  ],
  "bin": {
    "tickets": "bin/tickets"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./module": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./names": {
      "types": "./dist/names.d.ts",
      "default": "./dist/names.js"
    },
    "./SKILL.md": "./SKILL.md",
    "./dashboard": "./dist/dashboard/dashboard.js",
    "./server": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build -c dashboard/vite.config.ts",
    "prepack": "node -e \"if(!process.env.npm_config_user_agent?.startsWith('pnpm/')){console.error('Pack and publish with pnpm: it replaces workspace:* with the real version, npm does not');process.exit(1)}\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p dashboard/tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node ../../scripts/test-node.mjs && cd dashboard && vitest run",
    "clean": "rm -rf dist dist-test"
  },
  "dependencies": {
    "@openagt/agent-driver": "workspace:*",
    "@openagt/git-branches": "workspace:*",
    "@openagt/hooks": "workspace:*",
    "@openagt/store-filesystem": "workspace:*"
  },
  "devDependencies": {
    "@openagt/ui-renderer-markdown": "workspace:*",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.469.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
