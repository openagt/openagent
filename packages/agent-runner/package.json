{
  "name": "@openagt/agent-runner",
  "version": "0.0.8",
  "description": "Run one coding agent from start to end: its own checkout, one prompt, the agent's own loop, a run record on the project's agent-data branch; resume a run that ended on a question; and the sweep a scheduler runs to record the runs whose process died.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openagt/openagent.git",
    "directory": "packages/agent-runner"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "bin/agent-runner"
  ],
  "bin": {
    "agent-runner": "bin/agent-runner"
  },
  "openagent": {
    "hooks": "agent-runner",
    "cleanup": "agent-runner"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node -e \"if(!process.env.npm_config_user_agent?.startsWith('pnpm/')){console.error('Pack and publish with pnpm: it replaces workspace:* with the real version, npm does not');process.exit(1)}\"",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test --test-timeout=60000 'dist-test/**/*.test.js'",
    "clean": "rm -rf dist dist-test"
  },
  "dependencies": {
    "@openagt/agent-driver-claude": "workspace:*",
    "@openagt/agent-driver-codex": "workspace:*",
    "@openagt/agent-data": "workspace:*",
    "@openagt/skill-branches": "workspace:*",
    "@openagt/skill-github": "workspace:*",
    "@openagt/skill-logs": "workspace:*",
    "@openagt/skill-question": "workspace:*",
    "@openagt/agent-driver": "workspace:*",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
