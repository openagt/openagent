{
  "name": "@openagt/start",
  "version": "0.41.0",
  "description": "OpenAgent in one command: the dashboard, with the skills every agent gets by default. A project's own skill of the same name takes a default's place.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openagt/openagent.git",
    "directory": "packages/start"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "openagent": "dist/bin.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node -e \"if(!process.env.npm_config_user_agent?.startsWith('pnpm/')){console.error('Pack and publish with pnpm: it replaces workspace:* with the real version, npm does not');process.exit(1)}\"",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test --test-timeout=60000 'dist-test/**/*.test.js'",
    "clean": "rm -rf dist dist-test"
  },
  "dependencies": {
    "@openagt/agent-data": "workspace:*",
    "@openagt/dashboard": "workspace:*",
    "@openagt/skill-github": "workspace:*",
    "@openagt/skill-logs": "workspace:*",
    "@openagt/skill-orchestration": "workspace:*",
    "@openagt/skill-question": "workspace:*",
    "@openagt/skill-queue": "workspace:*",
    "@openagt/skill-tickets": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^7.0.2"
  }
}
