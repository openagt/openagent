{
  "name": "@openagt/dashboard",
  "version": "0.69.0",
  "description": "OpenAgent: autonomous AI programming. Coding agents work your repos unattended and hand the result off as pull requests. This package is OpenAgent as it ships: the modules it runs, and the openagent command that serves the dashboard (@openagt/ui) with them.",
  "keywords": [
    "ai",
    "agent",
    "claude-code",
    "codex",
    "openagent",
    "codegen",
    "cli",
    "turnkey"
  ],
  "license": "MIT",
  "homepage": "https://github.com/openagt/openagent/tree/main/packages/dashboard#readme",
  "bugs": {
    "url": "https://github.com/openagt/openagent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openagt/openagent.git",
    "directory": "packages/dashboard"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "openagent": "dist/bin.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node -e \"if(!process.env.npm_config_user_agent?.startsWith('pnpm/')){console.error('Pack and publish with pnpm: it replaces workspace:* with the real version, npm does not');process.exit(1)}\"",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node ../../scripts/test-node.mjs",
    "clean": "rm -rf dist dist-test"
  },
  "dependencies": {
    "@openagt/agent-runner": "workspace:*",
    "@openagt/dashboard-changes": "workspace:*",
    "@openagt/dashboard-devices": "workspace:*",
    "@openagt/dashboard-files": "workspace:*",
    "@openagt/hooks": "workspace:*",
    "@openagt/notifications-browser": "workspace:*",
    "@openagt/notifications-command": "workspace:*",
    "@openagt/skill-account-rotation": "workspace:*",
    "@openagt/skill-ask": "workspace:*",
    "@openagt/skill-branches": "workspace:*",
    "@openagt/skill-browser": "workspace:*",
    "@openagt/skill-discord": "workspace:*",
    "@openagt/skill-github": "workspace:*",
    "@openagt/skill-logs": "workspace:*",
    "@openagt/skill-queue": "workspace:*",
    "@openagt/skill-reply": "workspace:*",
    "@openagt/skill-scheduler": "workspace:*",
    "@openagt/skill-tickets": "workspace:*",
    "@openagt/skills": "workspace:*",
    "@openagt/store-filesystem": "workspace:*",
    "@openagt/store-git-branch": "workspace:*",
    "@openagt/store-git-repository": "workspace:*",
    "@openagt/ui": "workspace:*",
    "@openagt/ui-card-waiting": "workspace:*",
    "@openagt/ui-renderer-markdown": "workspace:*",
    "@openagt/ui-renderer-mermaid": "workspace:*",
    "@openagt/user-info": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
