{
  "name": "@openagt/ask",
  "version": "0.1.0",
  "description": "How a coding agent asks the person to decide: the skill that teaches it one await-choices block, the reading of that block, the question's card in the chat, the answer that resumes the run, and \"Needs answer\".",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openagt/openagent.git",
    "directory": "packages/ask"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "SKILL.md"
  ],
  "exports": {
    "./module": {
      "types": "./dist/module.d.ts",
      "default": "./dist/module.js"
    },
    "./question": {
      "types": "./dist/question.d.ts",
      "default": "./dist/question.js"
    },
    "./dashboard": "./dist/dashboard/dashboard.js",
    "./server": "./dist/server.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build -c dashboard/vite.config.ts",
    "prepack": "node -e \"if(!process.env.npm_config_user_agent?.startsWith('pnpm/')){console.error('Pack and publish with pnpm: it replaces workspace:* with the real version, npm does not');process.exit(1)}\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p dashboard/tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node ../../scripts/test-node.mjs && cd dashboard && vitest run",
    "clean": "rm -rf dist dist-test"
  },
  "dependencies": {
    "@openagt/hooks": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.469.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
