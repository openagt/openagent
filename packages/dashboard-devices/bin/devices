#!/usr/bin/env node
import { runCli } from '../dist/cli.js'

runCli(process.argv.slice(2), { env: process.env, stdout: line => console.log(line), stderr: line => console.error(line) })
  .then(code => {
    process.exitCode = code
    // Ended here, once what was printed is out: a question still asked of the network (this computer's name) must not hold the answer up.
    process.stdout.write('', () => process.exit())
  })
  .catch(err => {
    console.error(err)
    process.exitCode = 1
  })
