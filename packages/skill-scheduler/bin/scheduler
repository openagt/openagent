#!/usr/bin/env node
import { runCli } from '../dist/cli.js'

runCli(process.argv.slice(2), { cwd: process.cwd(), stdout: line => console.log(line), stderr: line => console.error(line) })
  .then(code => {
    process.exitCode = code
  })
  .catch(err => {
    console.error(err)
    process.exitCode = 1
  })
