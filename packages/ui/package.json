{
  "name": "@openagt/ui",
  "version": "0.1.0",
  "description": "OpenAgent's shell: the dashboard's pages and its server, and the openagent command that serves them, with the modules of the distribution that runs it (@openagt/dashboard). It starts a run on this computer's run host and shows every run from the files it keeps; it runs no coding agent itself.",
  "keywords": [
    "ai",
    "agent",
    "claude-code",
    "openagent"
  ],
  "license": "MIT",
  "homepage": "https://github.com/openagt/openagent/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/openagt/openagent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openagt/openagent.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./cli": {
      "types": "./dist/cli/cli.d.ts",
      "default": "./dist/cli/cli.js"
    },
    "./module": {
      "types": "./dist/module-types/dashboard/module/index.d.ts"
    },
    "./module.css": "./dist/module.css",
    "./secure-address": {
      "types": "./dist/secure-address.d.ts",
      "default": "./dist/secure-address.js"
    },
    "./join-dashboard": {
      "types": "./dist/join-dashboard.d.ts",
      "default": "./dist/join-dashboard.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p dashboard/tsconfig.module.json && cp dashboard/module/theme.css dist/module.css && node scripts/copy-website.mjs && cd dashboard && vite build",
    "prepack": "node -e \"if(!process.env.npm_config_user_agent?.startsWith('pnpm/')){console.error('Pack and publish with pnpm: it replaces workspace:* with the real version, npm does not');process.exit(1)}\"",
    "dev": "tsc -p tsconfig.build.json --watch",
    "dev:dashboard": "cd dashboard && vite",
    "dev:daemon": "cd dashboard && OPENAGENT_DEV_DAEMON=1 vite",
    "design:build": "tsx --tsconfig dashboard/tsconfig.json dashboard/design/build.mts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p dashboard/tsconfig.json",
    "test": "pnpm test:node && pnpm test:dashboard",
    "test:node": "tsc -p tsconfig.test.json && node ../../scripts/test-node.mjs",
    "test:dashboard": "cd dashboard && vitest run",
    "demo": "tsc -p tsconfig.test.json && node dist-test/e2e/demo-bin.js",
    "clean": "rm -rf dist dist-test"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@openagt/agent-data": "workspace:*",
    "@openagt/git-branches": "workspace:*",
    "@openagt/scheduled-agents": "workspace:*",
    "@shadcn/react": "^0.2.1",
    "@tiptap/core": "^2.10.0",
    "@tiptap/extension-hard-break": "^2.10.0",
    "@tiptap/extension-text": "^2.10.0",
    "@tiptap/pm": "^2.10.0",
    "@tiptap/react": "^2.10.0",
    "@tiptap/starter-kit": "^2.10.0",
    "@tiptap/suggestion": "^2.10.0",
    "@openagt/agent-driver": "workspace:*",
    "@openagt/hooks": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^4.14.2",
    "shiki": "4.5.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.0.0",
    "tiptap-markdown": "^0.8.10",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/source-code-pro": "^5.3.1",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@openagt/agent-driver-claude-code": "workspace:*",
    "@openagt/agent-driver-codex": "workspace:*",
    "@openagt/ui-pane-changes": "workspace:*",
    "@openagt/ui-pane-files": "workspace:*",
    "@openagt/host-claude-web": "workspace:*",
    "@openagt/host-github-actions": "workspace:*",
    "@openagt/notifications-browser": "workspace:*",
    "@openagt/notifications-command": "workspace:*",
    "@openagt/saved-prompts": "workspace:*",
    "@openagt/ask": "workspace:*",
    "@openagt/browser": "workspace:*",
    "@openagt/discord": "workspace:*",
    "@openagt/logs": "workspace:*",
    "@openagt/queue": "workspace:*",
    "@openagt/github": "workspace:*",
    "@openagt/github-auto-reply": "workspace:*",
    "@openagt/tickets": "workspace:*",
    "@openagt/store-filesystem": "workspace:*",
    "@openagt/store-git-branch": "workspace:*",
    "@openagt/store-git-repository": "workspace:*",
    "@openagt/ui-card-waiting": "workspace:*",
    "@openagt/ui-renderer-markdown": "workspace:*",
    "@openagt/ui-renderer-mermaid": "workspace:*",
    "@openagt/user-info": "workspace:*",
    "@openagt/profiles": "workspace:*",
    "@openagt/skills": "workspace:*",
    "@tailwindcss/oxide": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "material-icon-theme": "5.39.0",
    "playwright-core": "1.64.1",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  },
  "author": "Suleiman Shahbari",
  "publishConfig": {
    "access": "public"
  }
}
