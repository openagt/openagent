{
  "name": "@openagt/skill-branches",
  "version": "0.1.5",
  "description": "Branch management for coding agents: one git checkout per agent under .branches/, named as its branch, reclaimed once its work is on the remote.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openagt/openagent.git",
    "directory": "packages/skill-branches"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "bin/branches",
    "SKILL.md"
  ],
  "bin": {
    "branches": "bin/branches"
  },
  "openagent": {
    "branches": "branches",
    "cleanup": "branches"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./branch-names": {
      "types": "./dist/branch-names.d.ts",
      "default": "./dist/branch-names.js"
    }
  },
  "scripts": {
    "build": "cp ../../skills/branches/SKILL.md SKILL.md && tsc -p tsconfig.build.json",
    "prepack": "node -e \"if(!process.env.npm_config_user_agent?.startsWith('pnpm/')){console.error('Pack and publish with pnpm: it replaces workspace:* with the real version, npm does not');process.exit(1)}\" && cp ../../skills/branches/SKILL.md SKILL.md",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test --test-timeout=60000 'dist-test/**/*.test.js'",
    "clean": "rm -rf dist dist-test SKILL.md"
  },
  "dependencies": {
    "@openagt/agent-data": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^7.0.2"
  }
}
