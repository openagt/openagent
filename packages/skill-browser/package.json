{
  "name": "@openagt/skill-browser",
  "version": "0.1.3",
  "description": "A browser for coding agents: a headless Chrome the agent opens, reads, clicks and types into with the browser command, shown live to a person watching the run.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openagt/openagent.git",
    "directory": "packages/skill-browser"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "bin/browser",
    "SKILL.md"
  ],
  "bin": {
    "browser": "bin/browser"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dashboard": "./dist/dashboard/dashboard.js",
    "./SKILL.md": "./SKILL.md"
  },
  "scripts": {
    "build": "cp ../../skills/browser/SKILL.md SKILL.md && tsc -p tsconfig.build.json && vite build -c dashboard/vite.config.ts",
    "prepack": "cp ../../skills/browser/SKILL.md SKILL.md",
    "typecheck": "tsc --noEmit && tsc --noEmit -p dashboard/tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test --test-timeout=120000 'dist-test/**/*.test.js' && cd dashboard && vitest run",
    "clean": "rm -rf dist dist-test SKILL.md"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.469.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
