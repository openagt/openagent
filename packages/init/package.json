{
  "name": "@openagt/init",
  "version": "0.1.6",
  "description": "One command gives a project its OpenAgent skills: pick them from a list with ticks, and they are written as tracked files the coding agents read.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openagt/openagent.git",
    "directory": "packages/init"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "bin/openagent-init"
  ],
  "bin": {
    "openagent-init": "bin/openagent-init"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node -e \"if(!process.env.npm_config_user_agent?.startsWith('pnpm/')){console.error('Pack and publish with pnpm: it replaces workspace:* with the real version, npm does not');process.exit(1)}\"",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test --test-timeout=60000 'dist-test/**/*.test.js'",
    "clean": "rm -rf dist dist-test"
  },
  "dependencies": {
    "@openagt/agent-data": "workspace:*",
    "@openagt/agent-scheduler": "workspace:*",
    "@openagt/skill-browser": "workspace:*",
    "@openagt/skill-discord": "workspace:*",
    "@openagt/skill-github": "workspace:*",
    "@openagt/skill-maintainability": "workspace:*",
    "@openagt/skill-maintenance": "workspace:*",
    "@openagt/skill-market-research": "workspace:*",
    "@openagt/skill-orchestration": "workspace:*",
    "@openagt/skill-plan": "workspace:*",
    "@openagt/skill-plan-tickets": "workspace:*",
    "@openagt/skill-post-merge-cleanup": "workspace:*",
    "@openagt/skill-queue": "workspace:*",
    "@openagt/skill-readability": "workspace:*",
    "@openagt/skill-research": "workspace:*",
    "@openagt/skill-security-audit": "workspace:*",
    "@openagt/skill-suggest-new-features": "workspace:*",
    "@openagt/skill-suggest-new-tickets": "workspace:*",
    "@openagt/skill-suggest-tickets-to-work-on": "workspace:*",
    "@openagt/skill-tickets": "workspace:*",
    "@openagt/skill-triage": "workspace:*",
    "@openagt/skill-update-tickets": "workspace:*",
    "@openagt/skill-ux": "workspace:*",
    "@openagt/skill-work-queue": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^7.0.2"
  }
}
