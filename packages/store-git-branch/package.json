{
  "name": "@openagt/store-git-branch",
  "version": "0.1.0",
  "description": "OpenAgent's store plugin for a shared project: its data on the agent-data branch of its own repository, every save a commit pushed to origin, so the person's other computers, their team and cloud sessions read the same tickets, queue and records.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openagt/openagent.git",
    "directory": "packages/store-git-branch"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./module": {
      "types": "./dist/module.d.ts",
      "default": "./dist/module.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node ../../scripts/test-node.mjs",
    "clean": "rm -rf dist dist-test"
  },
  "dependencies": {
    "@openagt/agent-data": "workspace:*",
    "@openagt/hooks": "workspace:*",
    "@openagt/store-filesystem": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
