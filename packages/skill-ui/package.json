{
  "name": "@openagt/skill-ui",
  "version": "0.1.0",
  "description": "UI for skills: what a skill's package builds its cards on, and `npx @openagt/skill-ui`, a page on this computer that shows the cards of a folder's skills. The same cards show in OpenAgent's dashboard.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openagt/openagent.git",
    "directory": "packages/skill-ui"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "bin/skill-ui",
    "module/theme.css",
    "module/tokens.css"
  ],
  "bin": {
    "skill-ui": "bin/skill-ui"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./module": {
      "types": "./dist/module/index.d.ts",
      "default": "./dist/module/index.js"
    },
    "./host-modules": {
      "types": "./dist/host-modules.d.ts",
      "default": "./dist/host-modules.js"
    },
    "./theme.css": "./module/theme.css",
    "./tokens.css": "./module/tokens.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p module/tsconfig.build.json && vite build -c page/vite.config.ts",
    "prepack": "node -e \"if(!process.env.npm_config_user_agent?.startsWith('pnpm/')){console.error('Pack and publish with pnpm: it replaces workspace:* with the real version, npm does not');process.exit(1)}\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p module/tsconfig.json && tsc --noEmit -p page/tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test --test-timeout=60000 'dist-test/**/*.test.js' && vitest run -c module/vitest.config.ts",
    "clean": "rm -rf dist dist-test"
  },
  "dependencies": {
    "@openagt/agent-data": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
