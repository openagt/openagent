{
  "name": "@openagt/dashboard",
  "version": "0.10.0",
  "description": "OpenAgent: a local dashboard and daemon for coding agents. It starts an agent through the project's own start hook and shows every agent from the files it keeps; it runs no coding agent itself.",
  "keywords": [
    "ai",
    "agent",
    "claude-code",
    "orchestration",
    "openagent",
    "codegen",
    "cli",
    "turnkey"
  ],
  "license": "MIT",
  "homepage": "https://github.com/openagt/openagent/tree/main/packages/openagent#readme",
  "bugs": {
    "url": "https://github.com/openagt/openagent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openagt/openagent.git",
    "directory": "packages/openagent"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "openagent": "dist/bin.js"
  },
  "exports": {
    "./module": {
      "types": "./dist/module-types/dashboard/module/index.d.ts"
    },
    "./module.css": "./dist/module.css",
    "./module-server": {
      "types": "./dist/module-server.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p dashboard/tsconfig.module.json && cp dashboard/module/theme.css dist/module.css && cp src/module-server.d.ts dist/module-server.d.ts && node scripts/copy-extension.mjs && cd dashboard && vite build",
    "prepack": "node -e \"if(!process.env.npm_config_user_agent?.startsWith('pnpm/')){console.error('Pack and publish with pnpm: it replaces workspace:* with the real version, npm does not');process.exit(1)}\"",
    "preview": "node dist/bin.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "dev:dashboard": "cd dashboard && vite",
    "dev:daemon": "cd dashboard && OPENAGENT_DEV_DAEMON=1 vite",
    "design:build": "tsx dashboard/design/build.mts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p dashboard/tsconfig.json",
    "test": "pnpm test:node && pnpm test:dashboard",
    "test:node": "tsc -p tsconfig.test.json && node scripts/run-tests.mjs",
    "test:dashboard": "cd dashboard && vitest run",
    "clean": "rm -rf dist dist-test"
  },
  "dependencies": {
    "@openagt/agent-driver-claude": "workspace:*",
    "@openagt/agent-driver-codex": "workspace:*",
    "@base-ui-components/react": "1.0.0-rc.0",
    "@openagt/agent-data": "workspace:*",
    "@openagt/files": "workspace:*",
    "@openagt/remote-access": "workspace:*",
    "@openagt/init": "workspace:*",
    "@openagt/skill-branches": "workspace:*",
    "@openagt/skill-github": "workspace:*",
    "@openagt/skill-logs": "workspace:*",
    "@openagt/skill-orchestration": "workspace:*",
    "@openagt/skill-queue": "workspace:*",
    "@openagt/skill-tickets": "workspace:*",
    "@openagt/agent-scheduler": "workspace:*",
    "@puppeteer/browsers": "3.2.1",
    "@shadcn/react": "^0.2.1",
    "@tiptap/core": "^2.10.0",
    "@tiptap/pm": "^2.10.0",
    "@tiptap/react": "^2.10.0",
    "@tiptap/starter-kit": "^2.10.0",
    "@tiptap/suggestion": "^2.10.0",
    "@openagt/agent-driver": "workspace:*",
    "@openagt/agent-runner": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^2.6.0",
    "tiptap-markdown": "^0.8.10",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  },
  "author": "Suleiman Shahbari",
  "publishConfig": {
    "access": "public"
  }
}
