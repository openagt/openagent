{
  "name": "openagent",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "OpenAgent: autonomous AI programming — coding agents work your repos unattended and hand the result off as pull requests.",
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "// The dashboard's build builds the website for the copy it carries (#1919): left out here, it is built once": "",
    "build": "pnpm -r --filter '!__private__website' run build",
    "// Serve the production build the way an install does: the daemon, not a static server": "",
    "preview": "pnpm build && node packages/dashboard/dist/cli/bin.js",
    "dev": "pnpm build && pnpm -C packages/dashboard dev",
    "// The real dashboard on a throwaway home, with scripted offline runs: walk every flow, for free": "",
    "demo": "pnpm build && pnpm -C packages/dashboard demo",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean",
    "// Try this checkout on a server before publishing: what Update does, with this build in place of npm's": "",
    "try-on-server": "node scripts/try-on-server.mjs",
    "// Every package's tests, also after one fails: one run says everything that is wrong": "",
    "test": "pnpm -r --workspace-concurrency=1 --no-bail run test",
    "========= Website": "",
    "// Develop website https://openagent.build locally": "",
    "website": "pnpm -C packages/openagent.build dev",
    "// Build website for production": "",
    "website:build": "pnpm -C packages/openagent.build build",
    "// Test website: every page prerendered with its words (after `pnpm build`)": "",
    "website:test": "pnpm -C packages/openagent.build test"
  },
  "devDependencies": {
    "@openagt/skill-branches": "workspace:*",
    "@openagt/skill-github": "workspace:*",
    "@openagt/skill-tickets": "workspace:*",
    "@openagt/skill-queue": "workspace:*",
    "@openagt/skill-logs": "workspace:*",
    "@openagt/skill-browser": "workspace:*",
    "@openagt/skill-discord": "workspace:*",
    "@openagt/skill-orchestration": "workspace:*",
    "@openagt/agent-runner": "workspace:*",
    "@openagt/skill-scheduler": "workspace:*",
    "typescript": "^7.0.2"
  }
}
